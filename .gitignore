# Rust build output
/target
/crates/panopt-zellij/target

# PANopt's generated state projection - all of it is regenerated, except the
# committed project identity, which must travel with the tree (note #123).
# Ignore the directory's *contents* (not the directory) so the one file can be
# re-included: git cannot un-ignore a file under an excluded directory.
.panopt/*
!.panopt/project-id

# Local Claude Code settings
.claude/settings.local.json

# Tooling / OS
.sidecar/
.DS_Store

# Nix / direnv
/.direnv
/result
